# Apache Configuration - AutoHaus
# Habilitar compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control
<IfModule mod_expires.c>
  ExpiresActive On
  
  # HTML (no cachear)
  ExpiresByType text/html "now"
  
  # CSS y JavaScript (1 año)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Imágenes (1 año)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  
  # Fuentes (1 año)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  
  # JSON y datos (1 hora)
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Seguridad - Evitar acceso a archivos sensibles
<FilesMatch "^\.">
  Deny from all
</FilesMatch>

<FilesMatch "\.(env|json|log|md|sql)$">
  Deny from all
</FilesMatch>

# Rewrite (si es necesario para URL amigables)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirigir HTTP a HTTPS (descomentar en producción)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Eliminar .html de URLs (opcional)
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>
